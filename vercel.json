{
  "buildCommand": "cd lavie-website && npm run build",
  "outputDirectory": "lavie-website/dist",
  "installCommand": "cd lavie-website && npm install",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
